# TredaBot environment configuration — template
#
# Copy to .env and fill in the values:
#
#     cp .env.example .env
#
# Every value is baked into the bundle at BUILD TIME by rsbuild's
# `source.define` (see rsbuild.config.ts) — there is no runtime config. Editing
# .env has no effect until you restart `npm run dev` or rebuild.
#
# Only variables explicitly listed in `source.define` reach the client. Adding a
# new NEXT_PUBLIC_* line does nothing on its own; register it there too.
#
# The `NEXT_PUBLIC_*` prefix is a naming carryover from sibling Next.js
# templates. This is an Rsbuild + React Router SPA — the prefix has no special
# meaning to the bundler.
#
# Load order (later wins): .env -> .env.local. Both are gitignored; this
# template is the only env file that is committed, so keep real credentials out
# of it.

# -----------------------------------------------------------------------------
# Required — OAuth / Deriv application identity
# -----------------------------------------------------------------------------

# OAuth client_id of your Deriv application, from api.deriv.com -> Manage
# applications. Sent to /oauth2/auth, /oauth2/token, and the refresh-token call.
#
# When unset the app degrades rather than crashes: the Log in / Get Started
# buttons render disabled (header.tsx) and app-content raises a "Waiting for
# environment variables" notification. Nobody can sign in.
NEXT_PUBLIC_DERIV_APP_ID=""

# Where Deriv sends the browser back after login. Must be byte-identical to a
# redirect URI registered on the app above (RFC 6749 §4.1.3): it is checked at
# /oauth2/auth — a mismatch is rejected outright with `invalid_request`, before
# any redirect happens — and checked again at /oauth2/token, where a mismatch
# fails the exchange with `invalid_grant`.
#
# Both call sites derive it from getOAuthRedirectUri() (src/utils/oauth-redirect.ts),
# which normalises quotes, whitespace, and a trailing slash on a bare origin. If
# unset it falls back to window.location.origin.
#
# The path matters. Register either the bare origin or a dedicated path such as
# /callback — with a path, App.tsx mounts a router route for it and
# auth-bootstrap returns the user to the app root once the code exchange
# completes. Any path used here must be served the SPA: dev handles that
# automatically, production relies on the vercel.json rewrite.
#
# Local development needs a public HTTPS URL, since Deriv will not redirect to
# localhost. If you tunnel with ngrok, note that free subdomains rotate on every
# agent restart and invalidate the registration — claim an ngrok static domain
# and register it once instead.
#
#   e.g. https://your-app.example.com/callback
NEXT_PUBLIC_DERIV_REDIRECT_URI=""

# -----------------------------------------------------------------------------
# Optional
# -----------------------------------------------------------------------------

# Selects which Deriv backend the app talks to.
#
#   production  -> auth.deriv.com,          api.derivws.com
#   preview     -> staging-auth.deriv.com,  staging-api.derivws.com
#
# Use ONLY those two values. deriv-core's getEnv() treats anything that is not
# literally 'preview' as production, while config.ts's isProduction() also
# accepts 'staging' — so setting 'staging' authorizes against PRODUCTION auth
# while opening the STAGING WebSocket, and the socket connection fails. When the
# value is unset or unrecognised, the environment is inferred from the hostname.
NEXT_PUBLIC_DERIV_ENV="production"

# Display name, used as the first choice in getAppName() ahead of
# brand.config.json's brand_name / platform.name, falling back to 'TredaBot'.
# Cosmetic only — it is not sent to Deriv and does not affect auth.
NEXT_PUBLIC_DERIV_APP_NAME=""

# Affiliate / partner tracking link. parseReferralLink() extracts the affiliate
# token and any utm_* params from it and appends them to the OAuth authorization
# URL, so sign-ups are attributed.
#
# Omit it and the OAuth URL is simply built without those params. A live
# click-through carrying its own `t=` or `utm_*` query params overrides this at
# runtime (parseLandingParams).
NEXT_PUBLIC_DERIV_REFERRAL_LINK=""

# Set to "true" only by Deriv's App Builder preview pipeline. Switches the build
# output to out/preview with a /bot/preview/ asset prefix and a matching router
# basename. Leave unset for a standalone deploy; setting it locally will break
# asset paths.
# NEXT_PUBLIC_APP_BUILD="true"

# Google Drive integration for saving and loading strategies. All three are
# required together — is-google-drive-configured.ts enables the feature only
# when every one is present, and the Drive UI stays hidden otherwise.
# GD_CLIENT_ID=""
# GD_APP_ID=""
# GD_API_KEY=""
