{
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2022"],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true,
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "noEmit": true,
        "strict": false,
        "esModuleInterop": true,
        "types": ["node"]
    },
    "include": ["."]
}
