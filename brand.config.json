{
    "brand_name": "TredaBot",
    "brand_domain": "tredabot.com",
    "brand_hostname": {
        "staging": "staging.tredabot.com/dashboard",
        "production": "tredabot.com/dashboard"
    },
    "domain_name": "tredabot.com",
    "colors": {
        "primary": "#185FA5",
        "secondary": "#5F5E5A",
        "tertiary": "#378ADD",
        "navy": "#042C53",
        "accent": "#378ADD",
        "light_tint": "#E6F1FB",
        "page_background": "#F1EFE8",
        "border": "#B4B2A9",
        "text": "#2C2C2A",
        "text_secondary": "#5F5E5A",
        "success": "#10b981",
        "danger": "#ef4444",
        "warning": "#f59e0b",
        "info": "#378ADD",
        "neutral": "#B4B2A9",
        "black": "#2C2C2A",
        "white": "#ffffff",
        "grey": {
            "50": "#F1EFE8",
            "100": "#E6F1FB",
            "200": "#B4B2A9",
            "300": "#B4B2A9",
            "400": "#5F5E5A",
            "500": "#5F5E5A",
            "600": "#2C2C2A",
            "700": "#2C2C2A",
            "800": "#042C53",
            "900": "#042C53"
        }
    },
    "typography": {
        "font_family": {
            "primary": "Open Sans",
            "secondary": "Georgia, 'Times New Roman', Times, serif",
            "monospace": "'Courier New', Courier, monospace"
        },
        "font_sizes": {
            "xs": "0.75rem",
            "sm": "0.875rem",
            "base": "1rem",
            "lg": "1.125rem",
            "xl": "1.25rem",
            "2xl": "1.5rem",
            "3xl": "1.875rem",
            "4xl": "2.25rem"
        }
    },
    "color_variants": {
        "light_variants": [100, 200, 300, 400, 500],
        "dark_variants": [600, 700, 800, 900],
        "opacity_variants": [10, 20, 30, 40, 50, 60, 70, 80, 90]
    },
    "theme_config": {
        "enable_dynamic_themes": true,
        "auto_generate_variants": true,
        "css_variable_prefix": "--brand"
    },
    "platform": {
        "name": "TraderKAI App",
        "footer": {
            "enable_language_settings": false,
            "enable_theme_toggle": true
        },
        "hostname": {
            "production": {
                "com": "bot.tredabot.com"
            },
            "staging": {
                "com": "staging-bot.tredabot.com"
            }
        },
        "auth2_url": {
            "production": "https://auth.deriv.com/oauth2/",
            "staging": "https://staging-auth.deriv.com/oauth2/"
        },
        "derivws": {
            "url": {
                "staging": "https://staging-api.derivws.com/trading/v1/",
                "production": "https://api.derivws.com/trading/v1/"
            },
            "directories": {
                "options": "options/",
                "derivatives": "derivatives/"
            }
        }
    }
}
